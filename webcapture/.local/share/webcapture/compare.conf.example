# 变更检测配置（可选，不建就用默认值）
# 正式文件：~/webcapture/compare.conf

# 文本内容变化就报警（主信号，抗轮播图/广告噪声）
ALERT_ON_TEXT_CHANGE=1

# 图像像素变化也报警（噪声大，默认关）
ALERT_ON_IMAGE_CHANGE=0

# 图像变化阈值：变化像素占比超过它才算「变了」
IMAGE_DIFF_THRESHOLD=0.02

# 归一化时丢弃匹配到这些正则的整行（用 | 连接多个）
# 默认已过滤两类纯噪声：轮播图页码（1/5）、纯时间（09:07:31）
# 还有噪声就往后加，例：上午 访问量 这类每轮都变的文案
IGNORE_REGEX=^\d+/\d+$|^\d{1,2}:\d{2}(:\d{2})?$

# 报警里每个站点最多列几行新增/删除
MAX_SNIPPET_LINES=6
