# 截图失败报警配置 —— 只填你要用的那一个，另一个留空即可
# 正式文件是 ~/webcapture/notify.conf（本文件只是模板，不要在这里填）
# 改完跑一次自检： python3 notify.py --test

# ── 钉钉群机器人 ──────────────────────────────────────────────
# 群设置 → 机器人 → 添加机器人 → 自定义（通过Webhook接入）→ 复制 Webhook
# 形如：https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
DINGTALK_WEBHOOK=
# 安全设置选了「加签」才需要填（以 SEC 开头那一串）
DINGTALK_SECRET=
# 安全设置选了「自定义关键词」就填关键词，消息里会自动带上
DINGTALK_KEYWORD=

# ── 企业微信群机器人 ──────────────────────────────────────────
# 群设置 → 群机器人 → 添加 → 复制 Webhook
# 形如：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
WECOM_WEBHOOK=

# ── 失败降频 / 恢复通知 ──────────────────────────────────────
# 同一站点连续失败时，两次提醒的最小间隔（秒）。0 = 每次失败都报。
# 首次失败一定报；之后按这个间隔续报，避免一天刷 96 条。
FAIL_ALERT_INTERVAL=3600
# 站点从失败恢复正常时是否发一条恢复通知（1 开 / 0 关），形成闭环
ALERT_ON_RECOVER=1
