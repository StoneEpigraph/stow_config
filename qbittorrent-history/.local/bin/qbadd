#!/usr/bin/env python3
"""qbadd — 带"下过没有"检查的 qBittorrent 添加器。

  qbadd <磁力链接 | .torrent 文件>
  qbadd --yes <...>    跳过询问
  qbadd --check <...>  只检查不添加（等同 qbhist check）

以前下过就先给提示，选了"重新下载"才真的交给 qBittorrent。
退出码：0 正常（添加或取消），2 参数无法识别，3 用户取消。
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import qbhist_core as core  # noqa: E402


def ask_yes_no(title: str, text: str) -> bool:
    """优先图形对话框，退回终端。返回 True = 确认重新下载。"""
    has_gui = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    if has_gui and shutil.which("kdialog"):
        try:
            r = subprocess.run(["kdialog", "--title", title, "--yesno", text,
                                "--yes-label", "重新下载", "--no-label", "取消"],
                               capture_output=True)
            if r.returncode in (0, 1):
                return r.returncode == 0
        except Exception:
            pass
    if has_gui and shutil.which("zenity"):
        try:
            r = subprocess.run(["zenity", "--question", "--title", title,
                                f"--text={text}", "--ok-label=重新下载", "--cancel-label=取消"],
                               capture_output=True)
            if r.returncode in (0, 1):
                return r.returncode == 0
        except Exception:
            pass
    if not sys.stdin.isatty():
        return False
    print(text)
    try:
        return input("重新下载？[y/N] ").strip().lower() in ("y", "yes", "是")
    except EOFError:
        return False


def _deferred_sync(delay: int = 10) -> None:
    """qBittorrent 写完 .torrent 需要一点时间，稍后补一次同步，不必等定时器。"""
    hist = os.path.join(os.path.dirname(os.path.realpath(__file__)), "qbhist")
    if not os.path.exists(hist):
        return
    try:
        subprocess.Popen(["sh", "-c", f"sleep {delay}; exec '{hist}' sync"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception:
        pass


def add_to_qbittorrent(arg: str) -> int:
    qb = core.find_qbittorrent()
    if not qb:
        print("× 找不到 qbittorrent 可执行文件", file=sys.stderr)
        return 2
    try:
        subprocess.Popen([qb, arg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except Exception as e:
        print(f"× 启动 qBittorrent 失败：{e}", file=sys.stderr)
        return 2
    _deferred_sync()
    return 0


def localize(arg: str) -> str:
    """桌面环境（xdg / .desktop 的 %u）传 .torrent 时给的是 file:// URI，转回本地路径。"""
    if arg.lower().startswith("file://"):
        import urllib.parse
        import urllib.request
        p = urllib.parse.urlparse(arg)
        return urllib.request.url2pathname(urllib.parse.unquote(p.path))
    return arg


def main() -> int:
    args = sys.argv[1:]
    force = False
    check_only = False
    while args and args[0].startswith("-"):
        opt = args.pop(0)
        if opt in ("-y", "--yes", "--force"):
            force = True
        elif opt in ("-c", "--check"):
            check_only = True
        elif opt in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        else:
            print(f"未知选项：{opt}", file=sys.stderr)
            return 2
    if not args:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    target = localize(" ".join(args))
    ih, kind = core.resolve_input(target)
    if not ih:
        print(f"× {kind}", file=sys.stderr)
        # 认不出来就当作直接交给 qBittorrent（比如 http 种子链接）
        if not check_only and target.lower().startswith("http"):
            return add_to_qbittorrent(target)
        return 2

    row = core.lookup(ih)
    if check_only:
        if not row:
            print(f"✓ 没有下载记录（{kind}）")
            return 0
        print("⚠ 这个种子以前下载过\n")
        print(core.render_row(row))
        return 0

    if row and not force:
        parts = [
            "这个种子你以前下载过。",
            "",
            f"名称：{(row['name'] or '')[:120]}",
            f"大小：{core.human_size(row['total_size'])}",
        ]
        if row["completed_time"]:
            parts.append(f"完成于：{core.fmt_time(row['completed_time'])}")
        if row["save_path"]:
            parts.append(f"保存于：{row['save_path']}")
        if row["hit_count"] > 1:
            parts.append(f"已经下过 {row['hit_count']} 次")
        if not row["present"]:
            parts.append("当前不在 qBittorrent 列表里")
        parts += ["", "是否重新下载？"]
        if not ask_yes_no("qBittorrent 历史检查", "\n".join(parts)):
            print("已取消。")
            return 3
        print("→ 按你的确认重新添加")

    return add_to_qbittorrent(target)


if __name__ == "__main__":
    sys.exit(main())
