# Ghostty 配置（由 stow 包 ghostty 管理）
#
# 2026-11-03 精简重写。原来这里是一份 171KB 的 `ghostty +show-config` 全量导出，
# 里面把默认的 command-palette-entry（含 action:open_config）也写死了，导致启动/校验报：
#   command-palette-entry: invalid value "title:"Open Config",...,action:"open_config""
# Ghostty 自身的提示：不要把 `+show-config --default` 的输出贴进配置文件，
# 有些默认值写进配置后彼此冲突。查默认值用 `ghostty +show-config --default --docs`，只看不落地。
# 旧文件备份：~/ghostty-config.dump-20260514.bak

theme = Tomorrow Night Eighties

# 背景图
background-image = /home/stone/Pictures/wallpapers/1253579.jpg
background-image-opacity = 0.1
background-image-fit = cover

# 窗口尺寸
window-width = 240
window-height = 40

scrollback-limit = 10000000
copy-on-select = true

# 键位微调（只写与默认值不同的部分）
keybind = ctrl+,=open_config
keybind = ctrl+shift+page_up=jump_to_prompt:-1
keybind = ctrl+shift+page_down=jump_to_prompt:1
